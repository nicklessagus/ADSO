#!/bin/sh
# Segunda barrera: antes de pushear, escanea los MENSAJES de todos los commits
# salientes en busca de patrones de secretos. Ataja lo que commit-msg no vio
# (amend, rebase, --no-verify, mensajes generados por herramientas).
#
# Complementa a push protection de GitHub, que escanea contenido de archivos
# pero no mensajes de commit (asi se fugo el .env en 889c5ca, 2026-08-13).
#
# Activar con: git config core.hooksPath hooks

PATTERNS='gsk_[0-9A-Za-z]{16,}|AIza[0-9A-Za-z_-]{30,}|[0-9]{8,10}:AA[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9_-]{20,}|ghp_[0-9A-Za-z]{30,}|github_pat_[0-9A-Za-z_]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Borrado de ref remota: no hay commits salientes.
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # Ref nueva: escanear lo que no este ya en el remoto.
        range="$local_sha --not --remotes=origin"
    else
        range="$remote_sha..$local_sha"
    fi

    # shellcheck disable=SC2086  # range se expande a proposito
    bad=$(git log --format='%H' $range 2>/dev/null | while read -r sha; do
        if git log -1 --format='%B' "$sha" | grep -qE "$PATTERNS"; then
            echo "$sha"
        fi
    done)

    if [ -n "$bad" ]; then
        echo "pre-push: RECHAZADO — mensajes de commit con patron de credencial:" >&2
        for sha in $bad; do
            echo "  $sha  $(git log -1 --format='%s' "$sha")" >&2
        done
        echo "Reescribir el mensaje (git commit --amend / rebase -i) antes de pushear." >&2
        echo "Toda credencial que llegue a un push publico se considera comprometida." >&2
        status=1
    fi
done

exit $status
