# ─── Requeridas ─────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Opcionales ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR (default: INFO)
# ADSO_TIMEZONE=America/Argentina/Buenos_Aires
#                     # zona IANA para fechas relativas ("mañana", "el viernes").
#                     # Si falta se usa TZ (docker-compose ya la define) y luego UTC.

# ─── Paths (defaults para Docker) ──────────────────────────────────────────
# GOOGLE_CALENDAR_CREDS=./credentials   # directorio del HOST con google-oauth.json + token_tasks.json
#                                       # se monta como /credentials/ dentro del contenedor
# VAULT_PATH=/vault
# CHROMA_DATA_DIR=/app/data/chroma      # persistencia de ChromaDB

# ─── Permisos de archivos (Docker) ──────────────────────────────────────────
# El contenedor corre con este UID/GID para que los archivos del vault
# sean del usuario del host (no root). Obtener con: id -u && id -g
# ADSO_UID=1000
# ADSO_GID=1000
