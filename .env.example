# ─── Requeridas ─────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Opcionales ─────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR (default: INFO)
# ADSO_TIMEZONE=America/Argentina/Buenos_Aires
#                     # zona IANA para fechas relativas ("mañana", "el viernes").
#                     # Si falta se usa TZ (docker-compose ya la define) y luego UTC.

# ─── Paths ─────────────────────────────────────────────────────────────────
# Con Docker, estas dos son rutas DEL HOST: docker-compose las usa como origen
# de los bind-mounts. Los paths que ve el proceso adentro (/vault,
# /credentials/google-oauth.json) los fija el propio compose en `environment:`,
# NO este archivo.
#
# VAULT_PATH=/ruta/del/host/al/vault    # se monta como /vault en el contenedor.
#                                       # OJO: poner /vault acá montaría el
#                                       # directorio /vault DEL HOST.
# GOOGLE_CALENDAR_CREDS=/ruta/del/host/credentials
#                                       # DIRECTORIO del host con google-oauth.json
#                                       # + token_tasks.json; se monta como
#                                       # /credentials/. Adentro del contenedor la
#                                       # misma variable apunta a un ARCHIVO
#                                       # (/credentials/google-oauth.json).
#
# Sin Docker, ambas son rutas locales normales y valen tal como se escriban.
#
# Ruta INTERNA del contenedor (tocarla solo si se corre sin Docker):
# CHROMA_DATA_DIR=/app/data/chroma      # persistencia de ChromaDB (volumen adso-data)

# ─── Permisos de archivos (Docker) ──────────────────────────────────────────
# El contenedor corre con este UID/GID para que los archivos del vault
# sean del usuario del host (no root).
# Tienen que ser 1000: la imagen crea el usuario `adso` con UID/GID 1000 fijos
# y le da chown a /app/data. Otro valor rompe el push SSH del backup, la caché
# de whisper y ChromaDB — ver docs/installation.md §2.
# ADSO_UID=1000
# ADSO_GID=1000
