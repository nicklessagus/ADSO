      "Bash(ls .venv/bin/python*)",
      "Bash(python3 .venv/bin/pip install ruff -q)",
      "Read(//usr/bin/**)",
      "Bash(.venv/bin/python --version)",
      "Bash(.venv/bin/python -m pip install ruff -q)",
      "Bash(.venv/bin/python -m pytest --co -q -m \"not integration and not e2e\")",
      "Bash(TELEGRAM_TOKEN=dummy TELEGRAM_ALLOWED_USER_ID=12345 GEMINI_API_KEY=dummy VAULT_PATH=/tmp/adso_test_vault .venv/bin/python -m pytest -x -q -m \"not integration and not e2e\")",
      "Bash(TELEGRAM_TOKEN=dummy TELEGRAM_ALLOWED_USER_ID=12345 GEMINI_API_KEY=dummy VAULT_PATH=/tmp/adso_test_vault .venv/bin/python -m pytest tests/unit/test_security.py -q)",
      "Bash(TELEGRAM_TOKEN=dummy TELEGRAM_ALLOWED_USER_ID=12345 GEMINI_API_KEY=dummy VAULT_PATH=/tmp/adso_test_vault .venv/bin/python -m pytest -q -m \"not integration and not e2e\")",
      "Bash(TELEGRAM_TOKEN=dummy TELEGRAM_ALLOWED_USER_ID=12345 GEMINI_API_KEY=dummy VAULT_PATH=/tmp/adso_test_vault .venv/bin/python -m pytest --cov=adso --cov-report=term-missing --cov-fail-under=80 -q -m \"not integration and not e2e\")",
      "Bash(sort -t'%' -k1 -rn)",
      "Bash(ls *.cfg *.ini)",
      "Bash(TELEGRAM_TOKEN=dummy TELEGRAM_ALLOWED_USER_ID=12345 GEMINI_API_KEY=dummy VAULT_PATH=/tmp/adso_test_vault .venv/bin/python -m pytest --cov=adso --cov-report=term -q -m \"not integration and not e2e\")",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git push:*)",
      "Bash(ls *.md docs/*.md)",
      "Bash(TELEGRAM_ALLOWED_USER_ID=42 TELEGRAM_TOKEN=test GEMINI_API_KEY=test .venv/bin/python -m pytest tests/ -x -q)",
      "Bash(.venv/bin/python *)",
      "Bash(git commit -m ' *)",
      "Bash(~/.local/bin/ruff check *)",
      "Bash(git commit -q -m ' *)",
      "Bash(grep -rn \"except Exception:\\\\s*$\\\\|except:\\\\|except Exception:$\\\\|pass$\" adso/vault_writer.py adso/vault_search.py adso/vault_cache.py adso/document_extractor.py)",
      "Bash(TELEGRAM_ALLOWED_USER_ID=1 TELEGRAM_TOKEN=x GEMINI_API_KEY=x .venv/bin/python -m pytest -q)",
      "WebFetch(domain:ai.google.dev)",
      "Bash(awk 'NR>=490 && NR<=532 && /^async def|^def /{print NR\": \"$0}' adso/llm_client.py)",
      "Bash(awk -F: '$1>=450 && $1<=610')",
      "Bash(awk -F: '$1>=120 && $1<=160')",
      "Bash(TELEGRAM_ALLOWED_USER_ID=1 TELEGRAM_TOKEN=dummy GEMINI_API_KEY=dummy .venv/bin/python -m pytest -q)",
      "Bash(grep -iE \"^\\\\.env$|config\\\\.yaml$|token.*json|credentials|\\\\.pem$|\\\\.key$\")",
      "Bash(grep -nE 'AIza[0-9A-Za-z_-]{10,}')",
      "Bash(grep -nE 'gsk_[0-9A-Za-z]{20,}')",
      "Bash(grep -nE 'sk-\\(ant-\\)?[0-9A-Za-z_-]{20,}')",
      "Bash(grep -nE '[0-9]{8,10}:[A-Za-z0-9_-]{35}')",
      "Bash(bc)",
      "Bash(git rm *)",
      "Bash(.venv/bin/pip list *)",
      "Bash(TELEGRAM_ALLOWED_USER_ID=1 TELEGRAM_TOKEN=dummy GEMINI_API_KEY=dummy .venv/bin/python -c ' *)",
